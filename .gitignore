# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI agent skill docs auto-installed by `prisma init` (generic Prisma reference docs, not project-specific)
/.claude/skills
/.agents
/.windsurf
skills-lock.json

# sqlite dev database
*.db
*.db-journal

# allow the example env to be committed
!.env.example

# gateway credentials handed over out of band — never committed
pelecard-secrets.txt
