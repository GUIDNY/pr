# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Postgres connection string. Use a pooled/transaction-mode connection string
# (e.g. Supabase's "Transaction pooler", port 6543) rather than a direct
# connection — Vercel deploys every route as its own serverless function and
# keeps instances warm holding connections open, which exhausts a direct
# connection's low limit; a pooler is built for exactly that pattern.
DATABASE_URL="postgresql://user:password@host:6543/dbname?sslmode=no-verify"
AUTH_SECRET="replace-with-a-long-random-secret"

# Shared secret for POST /api/internal/complaints/ingest — the WhatsApp bot's
# only way in. At least 32 bytes, generated with `openssl rand -base64 48`.
# Lives in Vercel's environment variables and nowhere else: it is not in this
# file with a value, not in the repo, and never in client code. See
# docs/complaints-ingest.md.
INTERNAL_API_KEY=

# Supabase service-role key and project URL, used server-side only — the
# inventory source files, product images, and the private complaint-media
# bucket. There is deliberately no anon key here: nothing in this app talks
# to Supabase from the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Pelecard (credit card clearing)
# ---------------------------------------------------------------------------
# Pelecard has NO separate test credentials: the same terminal/user/password
# work against both environments, and the host below is the only thing
# deciding whether a card is really charged.
#   sandbox    https://gateway20.pelecard.biz
#   production https://gateway21.pelecard.biz
# The two hostnames appear in exactly one file in the codebase
# (src/lib/pelecard/config.ts). Never hard-code either anywhere else.
PELECARD_TERMINAL=
PELECARD_USER=
PELECARD_PASSWORD=
PELECARD_BASE_URL=https://gateway20.pelecard.biz

# Safety catch: pointing PELECARD_BASE_URL at gateway21 does nothing unless
# this is also set to exactly I_UNDERSTAND. Payments refuse to run otherwise.
PELECARD_ALLOW_PRODUCTION=

# The kill switch. While this is anything but "true", checkout keeps using the
# existing demo flow and no payment is ever opened.
PELECARD_ENABLED=false

# Our own secret, carried in the callback URL we hand Pelecard at init — it is
# how the callback endpoint knows a POST came from them. Generate with
# `openssl rand -hex 32`. Lives in Vercel and nowhere else.
PELECARD_CALLBACK_SECRET=

# Absolute site URL. Pelecard builds the customer's return links and the
# server-side callback URL from it, so it must be the real public address.
NEXT_PUBLIC_SITE_URL=https://pr-ayam.vercel.app

# --- Live test against the REAL gateway (preview deployments only) ---
# Opens the payment console against gateway21, where every payment is a REAL
# charge on a REAL card. It exists because the test gateway cannot complete a
# transaction against this terminal, which left no way to find out whether the
# terminal itself works.
#
# Needs all four at once, and is refused on the production deployment whatever
# they say:
#   PELECARD_BASE_URL=https://gateway21.pelecard.biz
#   PELECARD_ALLOW_PRODUCTION=I_UNDERSTAND
#   PELECARD_LIVE_TEST=I_WILL_BE_CHARGED
#   (VERCEL_ENV must not be "production")
#
# Capped at a few shekels per payment. Refunds are done in Pelecard's own panel.
# PELECARD_LIVE_TEST=I_WILL_BE_CHARGED
