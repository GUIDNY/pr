# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Postgres connection string. Use a pooled/transaction-mode connection string
# (e.g. Supabase's "Transaction pooler", port 6543) rather than a direct
# connection — Vercel deploys every route as its own serverless function and
# keeps instances warm holding connections open, which exhausts a direct
# connection's low limit; a pooler is built for exactly that pattern.
DATABASE_URL="postgresql://user:password@host:6543/dbname?sslmode=no-verify"
AUTH_SECRET="replace-with-a-long-random-secret"

# Shared secret for POST /api/internal/complaints/ingest — the WhatsApp bot's
# only way in. At least 32 bytes, generated with `openssl rand -base64 48`.
# Lives in Vercel's environment variables and nowhere else: it is not in this
# file with a value, not in the repo, and never in client code. See
# docs/complaints-ingest.md.
INTERNAL_API_KEY=

# Supabase service-role key and project URL, used server-side only — the
# inventory source files, product images, and the private complaint-media
# bucket. There is deliberately no anon key here: nothing in this app talks
# to Supabase from the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
