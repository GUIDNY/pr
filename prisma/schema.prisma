// PREC ecommerce + admin platform schema.
// Datasource is Postgres (required for Vercel — serverless functions have
// a read-only, ephemeral filesystem, so file-based SQLite cannot work there).
// Status/role fields are still plain String columns backed by TS unions +
// Zod schemas in src/lib/enums.ts rather than native Postgres `enum` blocks;
// that was originally to stay portable from a SQLite dev DB, and there's no
// need to churn it now — Strings work identically in Postgres, just without
// an extra DB-level constraint.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One-time links for "I forgot my password".
///
/// The token itself is never stored — only its SHA-256. What is emailed
/// exists in the customer's inbox and nowhere else, so a copy of this table
/// is a list of hashes and a hash cannot be pasted into a URL.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  passwordHash String
  /// Whether the owner has chosen a password. False for accounts created
  /// through Google: passwordHash holds random bytes so the column is
  /// satisfied, and nothing anybody can type will match it. The account page
  /// reads this to offer "set a password" instead of "change password".
  hasPassword  Boolean  @default(true)
  /// Whether the customer agreed to order updates on WhatsApp. Ticked at
  /// registration and at checkout; off means email only.
  whatsappOptIn Boolean @default(true)
  /// Explicit, prior consent to advertising (section 30א of the
  /// Communications Law): an unticked box the customer ticked, with the
  /// moment it was ticked. Off by default and never assumed.
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  name         String
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN | STAFF
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses         Address[]
  orders            Order[]
  cart              Cart?
  favorites         Favorite[]
  reviews           Review[]
  supportRequests   SupportRequest[]
  notes             OrderNote[]          @relation("NoteAuthor")
  statusChanges     OrderStatusHistory[] @relation("StatusChangedBy")
  assignedOrders    Order[]              @relation("AssignedEmployee")
  auditLogs         AuditLog[]
  passwordResets    PasswordResetToken[]
  uploadedSources   InventorySource[]    @relation("SourceUploadedBy")
  triggeredSyncRuns InventorySyncRun[]   @relation("SyncTriggeredBy")
  resolvedAlerts    InventoryAlert[]     @relation("AlertResolvedBy")
  cartFollowUps     Cart[]               @relation("CartFollowUp")
  complaints        Complaint[]          @relation("ComplaintCustomer")
  assignedComplaints Complaint[]         @relation("ComplaintAssignee")
  complaintMessages ComplaintMessage[]   @relation("ComplaintMessageAuthor")
  gameProfile       GameProfile?
  gameSpins         GameSpin[]
  memberCoupons     MemberCoupon[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  city      String
  street    String
  houseNo   String
  apartment String?
  zip       String?
  notes     String?
  isDefault Boolean @default(false)
  /* Did a person put this here on purpose, or did a checkout leave it behind?
     The book is written from orders, so without this every delivery to a new
     place adds a row the customer never asked to keep. One auto row is a
     convenience — prefill the next checkout — and four of the same flat is
     clutter they then have to tidy. See lib/address-book.ts. */
  savedByUser Boolean @default(false)

  orders Order[]

  @@index([userId])
}

// ---------- Catalog ----------

model Brand {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  logoUrl      String?
  description  String?
  // Longer researched write-up shown in the "About the Brand" panel on
  // every product page for this brand — separate from `description` (a
  // one-line blurb) since this is meant to be a real multi-paragraph piece,
  // collapsed behind "קרא עוד" by default. Plain text, same \n-separated
  // paragraph convention as Product.description (see
  // ProductDescriptionText) — not every brand has one yet.
  aboutContent String?
  /* The buying guide on the brand's own page — the same job
     Category.description does for a category, and the same HTML the same
     parser reads. Separate from `aboutContent`, which is the "about the
     brand" panel on every PRODUCT page of this brand: a paragraph that
     opens "what to find here" belongs on the listing and nowhere near a
     single product. Separate from `description`, which is one line and is
     what the meta description uses. */
  pageContent  String?
  isActive     Boolean  @default(true)
  seoTitle     String?
  seoDesc      String?
  createdAt    DateTime @default(now())

  products    Product[]
  images      BrandImage[]
  slugHistory BrandSlugHistory[]
}

// Lifestyle/brand imagery for the "About the Brand" panel — separate from
// Brand.logoUrl (the small mark shown in the hero banner), and separate
// from ProductImage (photos of one specific product) — this is imagery of
// the brand itself, shared across every product under it.
model BrandImage {
  id        String @id @default(cuid())
  brandId   String
  brand     Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)

  @@index([brandId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  icon        String?
  imageUrl    String?
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryTree")
  isFeatured  Boolean    @default(false)
  sortOrder   Int        @default(0)
  seoTitle    String?
  seoDesc     String?

  products   Product[]
  attributes CategoryAttribute[]

  @@index([parentId])
}

// Defines which spec fields apply to a category (e.g. TVs -> screen size, panel tech)
model CategoryAttribute {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String // machine key e.g. "screen_size"
  label      String // display label e.g. "גודל מסך"
  unit       String? // e.g. "\""
  inputType  String   @default("text") // text | number | select | boolean
  options    String? // JSON-encoded array for select inputs
  isFilter   Boolean  @default(true) // shows in PLP filters
  sortOrder  Int      @default(0)

  values ProductAttributeValue[]

  @@unique([categoryId, key])
}

model Product {
  id                   String    @id @default(cuid())
  sku                  String    @unique
  title                String
  slug                 String    @unique
  model                String? // the manufacturer's own model number (e.g. "HBG578ES3") — NOT the internal sku. Indexed: /api/integrations/products' ?hasModel=false filter and exact-model lookups both scan this.
  colorName            String? // e.g. "רוז גולד" — a real, structured field, not scraped/guessed; distinguishes same-capacity variants that differ only by finish (each with its own real manufacturer model number, e.g. M-LR8 vs M-LB8)
  // Ties the colour variants of one appliance together, so the product page
  // can offer the other finishes. Set deliberately — by the grouping script
  // or by hand — and never derived at read time.
  //
  // It has to be a stored column rather than a query over similar titles,
  // because the titles that look alike are mostly NOT variants: of 68 groups
  // that collapse to the same text once colour words are removed, 51 are the
  // same product entered twice. Matching on appearance would offer a shopper
  // a "second colour" that is the identical appliance, and it would do it
  // silently, on a page where the wrong click is a wrong order.
  //
  // Each variant stays a full product with its own slug, sku, price, stock
  // and images. This groups them; it does not merge them.
  variantGroupId       String?
  brandId              String
  brand                Brand     @relation(fields: [brandId], references: [id])
  categoryId           String
  category             Category  @relation(fields: [categoryId], references: [id])
  shortDescription     String?
  description          String?
  price                Float
  compareAtPrice       Float?
  // The barcode. Empty on every row today: the supplier price sheets carry
  // no barcode column, and the values will come from the ERP and the
  // importers as a separate import. The plumbing is here first so that
  // import is one UPDATE rather than a schema change plus a feed change
  // plus a JSON-LD change under time pressure.
  //
  // A string, not a number: an EAN-13 can begin with a zero, and a leading
  // zero is exactly the digit a numeric column drops. Google matches this
  // against its own product catalogue, so a 12-digit value is not a
  // near-miss, it is a rejected item.
  gtin13               String?
  installmentMonths    Int?
  warrantyMonths       Int       @default(12)
  // The warranty the price list actually states, which 1,915 rows do and the
  // catalog kept from none of them: every product read 12 months regardless.
  // warrantyText is the sentence the product page prints — a term, and where
  // the sheet says so an extension, its price and what it covers. The
  // extension is bought from the supplier, never from us, so it is a sentence
  // and not a line item. warrantySourceText is the cell verbatim: the sync
  // compares against it to tell "the supplier changed the warranty" from "a
  // person edited our wording", and rewrites only on the former.
  warrantyText         String?
  warrantySourceText   String?
  deliveryDays         Int       @default(7)
  stockStatus          String    @default("IN_STOCK") // IN_STOCK | LOW_STOCK | OUT_OF_STOCK | SPECIAL_ORDER | DISCONTINUED
  stockQty             Int       @default(0)
  // Whether the price list still offers this at all, which is a different
  // question from how many units a warehouse holds — see enums.ts
  // SOURCE_AVAILABILITIES and inventory/availability.ts. ORDERABLE sells with
  // no stock on hand (someone rings the supplier); the other three sell only
  // while a warehouse or showroom still has one. PUBLIC_PRODUCT_WHERE asks
  // both this and stockQty, and neither answers for the other.
  sourceAvailability   String    @default("ORDERABLE")
  // Which importer the unit came through, and who it was. The marker is
  // written inside the price list's brand cell ("גורניה י.שלום"), which is how
  // seven Brand rows came to be named after an importer; import-channel.ts
  // splits it off before the brand is resolved. A parallel-import page says so.
  importChannel        String    @default("OFFICIAL")
  importerName         String?
  isPublished          Boolean   @default(true)
  isFeatured           Boolean   @default(false)
  isBestSeller         Boolean   @default(false)
  ratingAvg            Float     @default(0)
  ratingCount          Int       @default(0)
  seoTitle             String?
  seoDesc              String?
  supplierId           String?
  supplier             Supplier? @relation(fields: [supplierId], references: [id])
  supplierSku          String?
  supplierCost         Float? // internal cost — admin-only, never serialized to public pages
  /// When a person last set this product's price by hand — and the reason
  /// the sync is allowed to manage the price of everything else.
  ///
  /// Until 11 October the sync never wrote price to an existing product at
  /// all. That rule was right and it was also expensive: 276 products were
  /// showing a price the price list had moved on from, the sync detected
  /// every difference, reported "289 price changes" a day, and applied none
  /// of them. The rule existed because re-applying the sheet on every run
  /// used to wipe a morning's corrections by the next morning.
  ///
  /// This column is what lets both things be true. Null means nobody has
  /// priced this product, so the price list manages it and a change in the
  /// sheet lands on the site at the next sync. Set means a person decided
  /// this price, and no sync will touch it again — the sheet's figure shows
  /// up in the price tab as a suggestion instead.
  ///
  /// Every manual writer sets it: the price sheet, the quick edit on the
  /// attention queue, and the admin product form. Backfilled for the five
  /// products that had ever been saved through that form; nothing else in
  /// the catalogue had any evidence of a human choosing its price.
  priceManualAt        DateTime?
  /// Which comparison in findExistingProduct bound this product to its row
  /// on the last sync, and the model the parser read off that row.
  ///
  /// Provenance, not state: nothing reads these to make a decision. They
  /// exist because on 11 October I could not answer "why is this product
  /// attached to that row" from the database at all. 119 products were
  /// matched to rows whose model column contradicts them, every guard in
  /// the matcher refuses exactly those pairs when asked directly, and the
  /// two facts cannot both be true — so one of my assumptions about what
  /// the parser reads is wrong, and nothing stored anywhere said which.
  ///
  /// Reading the sheet is the only way to settle it, and only production
  /// can reach the sheets. So the sync writes down what it saw: the door
  /// the row came through, and the model it compared. lastRowModel null on
  /// a product matched by position is the answer — the sheet said nothing
  /// about identity, and silence passes every guard by design.
  lastMatchPath        String?
  lastRowModel         String?
  extraSpecsRaw        String? // JSON object of spec fields an external source sent that didn't match any CategoryAttribute for this product's category — shown on the public product page only as a fallback when there's no structured spec at all (see product/[slug]/page.tsx), until someone maps the key to a real CategoryAttribute
  // Where the enrichment API's description/spec content was scraped from —
  // admin-only provenance, never rendered on the public product page. Set
  // by /api/integrations/product-enrich, independent of whether the content
  // itself was just written or was already there (a backfill-only call can
  // set these without touching description/extraSpecsRaw at all).
  descriptionSourceUrl String?
  specSourceUrl        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // ---- Inventory sync (Excel/ERP source of truth) ----
  isTemporarySku         Boolean          @default(false) // sku is a sequential placeholder (0001, 0002…), not from the source
  minSalePrice           Float? // internal floor price reference from source, admin-only
  // Fixed 5-bucket stock fields — superseded by the per-named-source
  // InventorySourceLine model below (one row per raw column: "תצוגה חדרה",
  // "בונדד עומר", etc.), which is the source of truth for the inventory
  // breakdown UI. Dead columns: nothing in the codebase writes any of the
  // five any more (grep confirms), and nothing reads them either — the
  // breakdown UI reads InventorySourceLine and everything else reads
  // stockQty. Left in place rather than dropped so no historical value is
  // destroyed, but do not start writing them: add to InventorySourceLine.
  sellableStock          Int? // "יתרה" — what's actually available to sell
  warehouseStock         Int? // "מלאי" + "טובים" columns, summed
  showroomStock          Int? // "תצוגה" columns (any branch), summed
  supplierStock          Int? // "בונדד ספק"
  bondedStock            Int? // "בונדד עומר" / other bonded-warehouse columns
  stockBreakdown         String? // JSON snapshot of the raw per-column stock values, for transparency/debugging
  internalNotes          String? // raw הערות text preserved from source, admin-only
  /// When a person took this product off the site, and null when nobody has.
  ///
  /// isPublished alone cannot tell "never published yet" from "somebody hid
  /// this", and reconcileAutoPublish needed to. It used an open
  /// NEW_FROM_SOURCE alert as the proxy — nobody has decided about this
  /// product yet — which is true only until the queue entry closes. Six
  /// products finished by the enrichment agent an hour after their entry was
  /// resolved sat ready and hidden with nothing that would ever publish them.
  /// Same shape as priceManualAt: a person's decision is recorded where a
  /// machine can see it, instead of being inferred from a flag that means
  /// two things.
  unpublishedAt          DateTime?
  enrichmentStatus       String           @default("NOT_ENRICHED") // NOT_ENRICHED | ENRICHED | NEEDS_REVIEW
  sourceId               String?
  source                 InventorySource? @relation(fields: [sourceId], references: [id])
  sourceSheet            String?
  sourceRowRef           Int?
  // What the sheet row itself said — brand, model and description hashed
  // together — so a row with no SKU can still be recognised after we have
  // edited its title, brand or category in the admin. See
  // lib/inventory/source-row-key.ts.
  sourceRowKey           String?
  lastExcelSyncAt        DateTime?
  missingFromSourceSince DateTime? // set when a previously-known product stops appearing in its source; never auto-deleted

  images              ProductImage[]
  attributeValues     ProductAttributeValue[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  favorites           Favorite[]
  reviews             Review[]
  changeEvents        InventoryChangeEvent[]
  alerts              InventoryAlert[]
  rowAliases          ProductRowAlias[]
  inventoryLines      InventorySourceLine[]
  enrichmentCandidate EnrichmentCandidate?
  slugHistory         ProductSlugHistory[]

  @@index([categoryId])
  @@index([brandId])
  @@index([sourceId])
  @@index([sourceId, sourceRowKey])
  @@index([isTemporarySku])
  @@index([model])
  @@index([variantGroupId])
}

// Every address this product has ever been reachable at, so a renamed
// product 301s from its old URL instead of 404ing. `slug` is public: it is
// in the product URL, it is what a customer pasted into WhatsApp and what
// Google has indexed, and once a link is out there it is out there
// permanently. A single "previous slug" column would have covered exactly
// one rename and stranded the first URL on the second — a row per address
// costs nothing and cannot develop that hole.
//
// Written by every path that changes a slug (see lib/product-slug-history.ts);
// read by product/[slug]/page.tsx when a slug misses.
// The same idea as ProductSlugHistory, for brands. A brand page is a public
// address too — linked from every product carrying that brand — so renaming
// one without recording the old value breaks whatever already points at it.
model BrandSlugHistory {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([brandId])
}

model ProductSlugHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([productId])
}

// A proposed image + description pulled from the manufacturer's own site,
// staged for a human to approve before it touches the live product — never
// applied automatically. Kept as its own table (not fields on Product) so
// "unreviewed draft" and "live data" can never be confused with each other.
model EnrichmentCandidate {
  id           String    @id @default(cuid())
  productId    String    @unique
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String?
  description  String?
  specs        String? // JSON object of { categoryAttribute.key: value } proposed from the manufacturer page — only keys matching a real CategoryAttribute for the product's category get applied on approval
  sourceUrl    String? // the manufacturer page this was pulled from, so an admin can verify it before approving
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  @@index([status])
}

// One row per named inventory location/source column found in the raw file
// (e.g. "מלאי חדרה", "תצוגה", "בונדד עומר", "מלאי ספק") — preserves *where*
// stock sits, not just a summed total. A sync replaces a product's full set
// of lines each run (delete + recreate) rather than trying to diff
// individual lines, since the whole point is "this is what the source says
// right now."
/// How big the shop was, sampled every time the watchdog runs.
///
/// There was no answer to "did the catalogue just shrink", and that is the
/// question every failure of 11-12 October would have been caught by: a
/// run swapped 45 live products for blanks on one evening and 14 more the
/// next morning, both reported SUCCESS, and the only reason anybody found
/// out was the owner asking an unrelated question. A check per known cause
/// catches the causes we know; a check on the size catches the next one.
///
/// Deliberately two numbers. `liveCount` is PUBLIC_PRODUCT_WHERE — what a
/// customer can buy — and `inStockCount` is what the price list says we
/// hold. A drop in the first with the second flat is us breaking
/// something; both falling together is the supplier selling out, which is
/// not a fault.
/// Every identity a sheet row has ever used for this product.
///
/// 577 of the 2,031 rows in the price lists carry no SKU of their own, and
/// a SKU is the only thing that identifies a row without guessing. For
/// those rows the import has three guesses — the row's position, a hash of
/// the row's text, and the model the row printed last time — and on
/// 11 and 12 October all three missed at once for 59 products, because the
/// supplier re-sorted the sheet *and* rewrote the text *and* enrichment had
/// since corrected our model. Each guess is sound; they are simply
/// correlated, so they fail together.
///
/// This is the fourth thing, and it is the one that accumulates rather than
/// being overwritten. Every model string and every row hash a product has
/// ever been seen under is kept, so the supplier renaming `8780IN` to
/// `CTAC8780AFSNE` adds a name instead of losing one, and the row is still
/// recognised by the name it used last month. Same idea as
/// ProductSlugHistory, which keeps a URL working after a rename, for the
/// same reason: the thing people and suppliers do to an identifier is
/// change it.
///
/// Unique per (source, tab, kind, value): an identity two products both
/// claim is not an identity, so the first to hold it keeps it and the
/// second falls through to the ordinary guesses rather than stealing a row.
model ProductRowAlias {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceId    String
  source      InventorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sheetName   String
  /// MODEL — the model string the sheet printed. ROWKEY — sourceRowKeyFor.
  ///
  /// Two more exist and are deliberately unreachable, because the lookup
  /// asks for the two above by name: MODEL_AMBIGUOUS, a model string that
  /// a second product in the same tab also answers to, and MISBOUND_*, an
  /// alias seeded from a product we know is reading the wrong row. Both
  /// are kept rather than deleted — a name that was rejected, and why, is
  /// worth more than a gap.
  kind        String
  value       String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([sourceId, sheetName, kind, value])
  @@index([productId])
}

model CatalogSizeSnapshot {
  id           String   @id @default(cuid())
  takenAt      DateTime @default(now())
  liveCount    Int
  inStockCount Int

  @@index([takenAt])
}

model InventorySourceLine {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String // original column label from the source, e.g. "תצוגה חדרה"
  quantity  Int
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Single global counter for sequential temporary SKUs (0001, 0002, …)
// assigned to products with no real SKU in their source. A dedicated
// counter (rather than scanning MAX(sku)) keeps allocation simple and
// monotonic even as temp-SKU'd products later get upgraded to a real SKU.
model TempSkuCounter {
  id    String @id @default("singleton")
  value Int    @default(0)
}

model ProductImage {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url            String
  alt            String?
  sortOrder      Int       @default(0)
  // Provenance for images written by /api/integrations/product-enrich —
  // admin-only, never rendered on the public product page. Null for images
  // added through the admin UI (drag-and-drop upload or a plain URL), which
  // have no "source page" to record.
  sourcePageUrl  String?
  sourceImageUrl String?
  sourceDomain   String?
  capturedAt     DateTime?
  /// When this image last failed to migrate onto our own storage.
  ///
  /// A failure leaves the row untouched — that is deliberate, so a product
  /// keeps its working hotlink — but it also means the candidate query
  /// returns the same image again, and the cron restarts at the front of
  /// the queue on every invocation. 60 runs overnight moved 67 images:
  /// each 45-second run spent its whole budget re-discovering the same
  /// refusals at the head of the list. The browser loop never saw this
  /// because it threads its skip-list forward across one long session.
  ///
  /// So a failure is written down. Anything that failed recently is left
  /// out of the queue, which lets each run start where the last one
  /// effectively finished. A timestamp rather than a boolean so it expires:
  /// a host that was down comes back, and the retry costs one attempt a few
  /// days later instead of four every five minutes.
  migrationFailedAt DateTime?

  @@index([productId])
  @@index([migrationFailedAt])
}

model ProductAttributeValue {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  @@unique([productId, attributeId])
}

// ---------- Suppliers ----------

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactName   String?
  phone         String?
  email         String?
  internalNotes String?
  leadTimeDays  Int      @default(7)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  products Product[]
  orders   Order[]
}

// ---------- Promotions ----------

model Promotion {
  id            String    @id @default(cuid())
  name          String
  code          String?   @unique // null = automatic promo (not a coupon)
  type          String // PERCENTAGE | FIXED
  value         Float
  scope         String // CART | CATEGORY | BRAND | PRODUCT
  scopeRefId    String? // categoryId / brandId / productId depending on scope
  minCartAmount Float?
  // The most a PERCENTAGE coupon may take off, in shekels (the mall wheel's 5% is capped). Null = no cap.
  maxDiscount   Float?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  /// What the customer is told when the code takes ("10% על כל המקררים").
  description      String?
  /// How many orders may use the code in total; null = unlimited. Counted
  /// from paid orders carrying the code, never stored.
  usageLimit       Int?
  /// How many orders one customer (account or email) may use it on.
  perCustomerLimit Int?
  /// Only for a customer with no paid order yet.
  firstOrderOnly   Boolean   @default(false)
  /// Only for a signed-in account; a guest is told to sign in.
  membersOnly      Boolean   @default(false)
  updatedAt        DateTime  @default(now()) @updatedAt
}

// ---------- Cart ----------

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?  @unique
  /// The visit (bt_sid, lib/pageview) this cart was created in, so a
  /// session's path through the site can be joined to what it put in the
  /// cart. A visit id, not a visitor id: it lapses within 24 hours.
  visitSid   String?
  couponCode String?
  /// Where the visitor came from (lib/attribution.ts), as the browser
  /// recorded it when the cart was made.
  attribution Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // What the customer typed into the checkout form before leaving it. The
  // cart's items are already here and createOrderAction empties them the
  // moment an order is placed, so a cart that still has items and a contactAt
  // is, by construction, one that was abandoned mid-checkout.
  contactName  String?
  contactPhone String?
  contactEmail String?
  contactAt    DateTime?

  // The callback workflow behind /admin/abandoned, so two people don't ring
  // the same customer.
  followUpStatus String    @default("NEW") // NEW | HANDLED | NOT_RELEVANT
  followUpNote   String?
  followUpAt     DateTime?
  followUpById   String?
  followUpBy     User?     @relation("CartFollowUp", fields: [followUpById], references: [id])

  items CartItem[]

  @@index([contactAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// The customer's character in the 3D mall at play.buytoday.co.il — see
// src/lib/game-profile.ts for what it may contain and app/api/game/profile
// for the only route that reads or writes it.
//
// A table of its own rather than a `gameProfile Json?` column on User, and
// the reason is the order things reach production in. There is no migrate
// step on deploy here: DDL is run by hand (scripts/create-game-profile-table.ts)
// and the code ships on a push. A new column on User that the code knows
// about and the database does not yet have breaks every `db.user.findUnique`
// without a `select` — getCurrentUser, every sign-in callback — which is
// every customer signing in, over a toy. A missing table breaks only the two
// game routes. The relation field on User above is Prisma's bookkeeping and
// is not a column.
//
// One row per account, keyed by the account, and gone with it: deleting an
// account cascades here, so the account-deletion flow needs no change.
model GameProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Always the output of parseGameProfile — never the request body as sent.
  profile   Json
  // Always the output of parseGameProgress (lib/game-progress.ts). Cosmetic only.
  progress  Json?
  updatedAt DateTime @updatedAt
}

// ---------- Orders ----------

model Order {
  id                 String    @id @default(cuid())
  orderNumber        String    @unique
  userId             String?
  user               User?     @relation(fields: [userId], references: [id])
  guestName          String?
  guestEmail         String?
  guestPhone         String?
  // The address this order is going to, held by the order itself — the same
  // reasoning as titleSnap and priceSnap on OrderItem. `address` below is a row
  // in the customer's address book: it belongs to an account (Address.userId is
  // required), so a guest could never have one, and a guest's delivery order was
  // saved with nowhere to send it. It is also editable and deletable by the
  // customer long after the order shipped, which is not what an order record of
  // where it went should be. Written for every DELIVERY order, guest or not.
  shipCity           String?
  shipStreet         String?
  shipHouseNo        String?
  shipApartment      String?
  // Set when the account that placed this order closed it. The row then looks
  // exactly like a guest order — userId null, contact details in the guest
  // fields — and this is the only thing that tells them apart, so registering
  // that email again never hands these back. See claimGuestOrders.
  ownerDeletedAt     DateTime?
  /// Moved to the bin by the back office, not deleted. Set means the order
  /// is out of every queue and count but still here: the row, its items and
  /// its history are untouched, and restoring it is one click. Only an order
  /// that took no real money can get here — see trashOrdersAction.
  deletedAt          DateTime?
  addressId          String?
  address            Address?  @relation(fields: [addressId], references: [id])
  deliveryMethod     String    @default("DELIVERY") // DELIVERY | PICKUP
  status             String    @default("NEW")
  // NEW | PAYMENT_PENDING | PAID | PROCESSING | AWAITING_SUPPLIER |
  // SUPPLIER_CONFIRMED | READY_FOR_DELIVERY | SHIPPED | DELIVERED |
  // CANCELLED | REFUND_PENDING | REFUNDED
  subtotal           Float
  discountTotal      Float     @default(0)
  // What the CUSTOMER paid for delivery. Income.
  deliveryFee        Float     @default(0)
  // What the delivery actually COST the shop, typed into the order page by
  // hand. There is no carrier integration to read it from and the figure
  // differs per order, so it is entered rather than derived. Null means
  // nobody has entered it yet, which is not the same as zero — the profit
  // panel says "before delivery" until it is filled in.
  deliveryCost       Float?
  total              Float
  couponCode         String?
  paymentStatus      String    @default("PENDING") // PENDING | AUTHORIZED | CAPTURED | FAILED | REFUNDED
  /// Where the customer came from (lib/attribution.ts): the browser's
  /// record at order time, or the cart's if the cookie is gone.
  attribution        Json?
  /// The visit (bt_sid, lib/pageview) the order was placed in — joins the
  /// page-view log to the sale. Lapses within 24 hours by design.
  visitSid           String?
  /// GA4's client and session ids from the browser that placed the order,
  /// so the server-side purchase report is the same client as the browser's
  /// and GA4 deduplicates the two. Null without consent.
  gaClientId         String?
  gaSessionId        String?
  /// GA4 Measurement Protocol purchase sent for this order (once only).
  ga4PurchaseSentAt  DateTime?
  /// The customer's answer to "updates on WhatsApp too?" for this order.
  /// Read by the notifier: off means the WhatsApp lane is skipped, email goes.
  whatsappOptIn      Boolean   @default(true)
  /// The advertising-consent box as it was at checkout, kept with the order
  /// so a guest's consent has a record and a time (createdAt).
  marketingOptIn     Boolean   @default(false)
  paymentMethod      String? // DEMO_CARD | CASH_ON_DELIVERY
  supplierId         String?
  supplier           Supplier? @relation(fields: [supplierId], references: [id])
  assignedToId       String?
  assignedTo         User?     @relation("AssignedEmployee", fields: [assignedToId], references: [id])
  customerNote       String?
  expectedDeliveryAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ---------- Delivery, once it has left ----------
  // Written when the order is marked shipped. trackingUrl is stored rather
  // than built from the number: every courier has a different address for it
  // and some have none, and a link built from a pattern is a link that 404s
  // in front of a customer.
  courierName    String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  notes         OrderNote[]
  notifications OrderNotification[]

  @@index([status])
  @@index([userId])
  @@index([deletedAt])
  @@index([visitSid])
  complaints         Complaint[]
}

/// Every message the shop sent a customer about an order, and every one it
/// tried to send and could not.
///
/// A log and not a queue. What it buys is the answer to "did the customer
/// ever hear about this", which is the first question asked when one rings
/// up confused — and without a row it can only be guessed at. A failure is
/// as much worth keeping as a success: a WhatsApp that never went is the
/// reason the customer is on the phone.
///
/// The unique index on (orderId, channel, event) is the thing that stops a
/// retried action from texting somebody twice. Sending late is a nuisance;
/// sending twice is what makes people mute a shop.
model OrderNotification {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel   String // EMAIL | SMS | WHATSAPP
  event     String // ORDER_RECEIVED | PAYMENT_APPROVED | SHIPPED | DELIVERED
  recipient String?
  status    String    @default("QUEUED") // QUEUED | SENT | FAILED | SKIPPED
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  // The provider's own id for the message (WhatsApp's wamid), so a delivery
  // status that arrives later on the webhook finds its row.
  providerMessageId String?

  @@unique([orderId, channel, event])
  @@index([orderId])
  @@index([providerMessageId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  titleSnap String // product title snapshot at purchase time
  skuSnap   String
  priceSnap Float
  // What the product cost us the day it was ordered (Product.supplierCost
  // then). A snapshot, like the price, because the price list moves and a
  // profit figure read off today's cost would drift under last month's
  // orders. Null when the product had no cost on record.
  costSnap  Float?
  quantity  Int

  @@index([orderId])
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String   @default("DEMO") // DEMO | PELECARD
  amount    Float
  status    String // PENDING | AUTHORIZED | CAPTURED | FAILED | REFUNDED
  reference String?
  createdAt DateTime @default(now())

  // ---------- Gateway record ----------
  // `amount` above is a Float because that is how this database has always
  // stored money; amountAgorot is the integer the gateway was actually asked
  // to charge, and it is what the callback checks the charged sum against.
  // Money comparisons happen on this column, never on the float.
  amountAgorot Int?

  // Which gateway this went through — the sandbox and the real one are the
  // same credentials against different hosts, so without this a row cannot be
  // told apart from a real charge afterwards.
  environment String? // sandbox | production

  confirmationKey       String? // from init; without it a transaction can't be validated
  pelecardTransactionId String?
  pelecardStatusCode    String? // "000" is success
  approvalNo            String?
  voucherId             String?
  cardLast4             String?
  // "MM/YY" as the gateway reports it (CreditCardExpDate, MMYY). The back
  // office asks for it when a hold has to be re-taken or a card re-charged.
  cardExpiry            String?
  clearerName           String?
  totalPayments         Int?
  rawResponse           Json? // the full exchange, for the day something is disputed
  updatedAt             DateTime? @updatedAt

  // ---------- J5: money held, not yet taken ----------
  // The handle Pelecard's CompleteDebitByUid needs to turn this hold into a
  // charge. Without it the hold cannot be collected at all — the money sits
  // frozen on the customer's card until it lapses — so a hold that arrives
  // without one raises an alert rather than being filed quietly.
  authorizationUid String?
  authorizedAt     DateTime?
  capturedAt       DateTime?
  // A hold is not open-ended. What the window actually is comes from the
  // card networks via Pelecard, not from us, so it is stored per payment
  // rather than assumed: PELECARD_HOLD_DAYS sets it and the default is
  // conservative on purpose — expiring early costs a phone call, expiring
  // late costs the sale.
  holdExpiresAt    DateTime?

  @@index([pelecardTransactionId])
  @@index([orderId])
  @@index([authorizationUid])
  @@index([status, holdExpiresAt])
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedById String?
  changedBy   User?    @relation("StatusChangedBy", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("NoteAuthor", fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// ---------- Content ----------

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String
  rating     Int
  title      String?
  body       String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model SupportRequest {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  phone     String
  email     String?
  channel   String   @default("CALLBACK") // CALLBACK | WHATSAPP | PHONE | FORM
  topic     String?
  message   String?
  status    String   @default("OPEN") // OPEN | CONTACTED | CLOSED
  createdAt DateTime @default(now())
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id        String  @id @default(cuid())
  key       String  @unique // hero | categories | deals | brands | why-prec
  title     String?
  subtitle  String?
  payload   String // JSON-encoded content specific to the section
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   String? // JSON-encoded diff/details
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------- Inventory sync (Excel today, Priority ERP later — see InventorySource) ----------

model InventorySource {
  id                   String    @id @default(cuid())
  key                  String    @unique // stable slug, e.g. "electronics" | "coffee-machines-sheet"
  sourceType           String    @default("EXCEL") // EXCEL | GOOGLE_SHEET
  filename             String
  storagePath          String? // Supabase Storage object path (EXCEL sources only)
  sheetUrl             String? // Google Sheets URL (GOOGLE_SHEET sources only)
  sheetGid             String? // the specific tab's gid within the spreadsheet
  categorySlugOverride String? // GOOGLE_SHEET sources are usually single-category; skip the per-tab sheet map
  fileHash             String? // sha256 of the fetched content, used to skip a scan when nothing changed
  fileSizeBytes        Int?
  isActive             Boolean   @default(true) // multiple sources can be active — all active sources are merged on sync
  uploadedAt           DateTime  @default(now())
  uploadedById         String?
  uploadedBy           User?     @relation("SourceUploadedBy", fields: [uploadedById], references: [id])
  lastScannedAt        DateTime? // last time we checked the content hash, whether or not it had changed
  lastSyncedAt         DateTime? // last time a scan actually found and applied changes
  createdAt            DateTime  @default(now())

  products     Product[]
  changeEvents InventoryChangeEvent[]
  alerts       InventoryAlert[]
  rowAliases   ProductRowAlias[]
}

model InventorySyncRun {
  id              String    @id @default(cuid())
  status          String    @default("RUNNING") // RUNNING | SUCCESS | FAILED | NO_CHANGES
  trigger         String // MANUAL | SCHEDULED
  triggeredById   String?
  triggeredBy     User?     @relation("SyncTriggeredBy", fields: [triggeredById], references: [id])
  sourceIds       String // JSON array of InventorySource ids included in this run
  rowsScanned     Int       @default(0)
  productsAdded   Int       @default(0)
  productsUpdated Int       @default(0)
  productsMissing Int       @default(0)
  priceChanges    Int       @default(0)
  /// Of priceChanges, how many prices this run actually wrote.
  ///
  /// priceChanges counts the differences the sheet reported, which it has
  /// always done; until 11 October none of them were applied, and the two
  /// numbers were 289 and 0. Now most are applied and some are deliberately
  /// not — a price a person set, a sale in progress, a figure under the cost
  /// on its own row, a row not assertably this product's. One number cannot
  /// say both, and a run that wrote 144 prices must not report 345.
  pricesAdopted   Int       @default(0)
  stockChanges    Int       @default(0)
  errorCount      Int       @default(0)
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  changeEvents InventoryChangeEvent[]
  alerts       InventoryAlert[]
}

// Lightweight event stream (not a full catalog snapshot per run) — enough to
// answer "what changed and when" without storing the whole product state on
// every sync.
model InventoryChangeEvent {
  id            String           @id @default(cuid())
  syncRunId     String
  syncRun       InventorySyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  sourceId      String?
  source        InventorySource? @relation(fields: [sourceId], references: [id])
  sourceSku     String?
  sourceSheet   String?
  changeType    String
  // PRICE_CHANGED | STOCK_INCREASED | STOCK_DECREASED | BECAME_OUT_OF_STOCK |
  // BACK_IN_STOCK | NEW_PRODUCT | PRODUCT_MISSING_FROM_SOURCE |
  // SUPPLIER_STOCK_CHANGED | SHOWROOM_STOCK_CHANGED | PRODUCT_DATA_CHANGED |
  // SOURCE_CONFLICT
  previousValue String? // JSON
  newValue      String? // JSON
  createdAt     DateTime         @default(now())

  @@index([productId])
  @@index([syncRunId])
  @@index([changeType])
  @@index([createdAt])
}

model InventoryAlert {
  id           String            @id @default(cuid())
  type         String
  // LOW_STOCK | OUT_OF_STOCK | UNMATCHED_ROW | DUPLICATE_SKU | DUPLICATE_MODEL |
  // INVALID_PRICE | MISSING_MODEL | UNKNOWN_COLUMN | NEGATIVE_STOCK |
  // MAJOR_STOCK_CHANGE | MISSING_FROM_SOURCE | SOURCE_CONFLICT |
  // URGENT_MISSING_MEDIA | MISSING_IMAGE | NEW_FROM_SOURCE |
  // MANUAL_ATTENTION | MANUAL_URGENT
  severity     String            @default("WARNING") // INFO | WARNING | CRITICAL
  productId    String?
  product      Product?          @relation(fields: [productId], references: [id])
  sourceId     String?
  source       InventorySource?  @relation(fields: [sourceId], references: [id])
  syncRunId    String?
  syncRun      InventorySyncRun? @relation(fields: [syncRunId], references: [id])
  sourceSku    String?
  message      String
  metadata     String? // JSON
  isResolved   Boolean           @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?             @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  createdAt    DateTime          @default(now())

  @@index([type])
  @@index([isResolved])
  @@index([productId])
  @@index([createdAt])
}

// ---------- Content / SEO ----------

// Blog-style buying-guide content, separate from CmsPage (which is flat
// one-off pages like About/Terms with no listing, no cover image, no
// per-article SEO fields). `content` is a JSON-encoded array of typed
// blocks ({type:"heading"|"paragraph"|"list", ...}) rather than raw HTML or
// markdown — every article here is authored by us, not user-submitted, so
// there's no injection risk either way, but structured blocks render
// predictably and keep heading hierarchy correct for SEO without pulling in
// a markdown dependency for a handful of admin-authored posts.
model Article {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  excerpt             String
  content             String
  coverImageUrl       String?
  category            String?
  // Slug of the real Category this article should send a reader to — the
  // internal-linking CTA at the bottom of the article page, not just the
  // freeform display label above (`category`).
  relatedCategorySlug String?
  seoTitle            String?
  seoDesc             String?
  isPublished         Boolean  @default(true)
  publishedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// Singleton row (fixed id, same pattern as TempSkuCounter) holding the
// facts the "אלפרד" chat bot (see /api/alfred-chat) states as policy —
// shipping time, warranty, service hours. Editable from /admin/chatbot so
// an admin can correct these the moment they change in real life, instead
// of them being hardcoded strings in the bot's system prompt that need a
// code deploy to update.
model ChatbotSettings {
  id              String   @id @default("singleton")
  shippingInfo    String   @default("עד הבית תוך כמה ימי עסקים, תלוי במוצר")
  warrantyInfo    String   @default("אחריות יבואן רשמי על כל המוצרים באתר")
  serviceHours    String?
  additionalNotes String?
  updatedAt       DateTime @updatedAt
}

// A WhatsApp conversation the bot could not close on its own, kept as a
// thread rather than the single alert it used to be.
//
// The rule that shapes everything here: the customer is never told this
// exists. No ticket number reaches them, no "we opened a case", no change in
// how the bot answers. The whole record is written after the reply has
// already gone out, on a path the reply does not depend on — see
// src/app/api/internal/complaints/ingest/route.ts.
//
// Deliberately NOT an extension of SupportRequest: that table is the site's
// "contact us" form — one submission, no thread, no WhatsApp identity, no
// severity — and widening it to carry conversations would leave both jobs
// half done.
model Complaint {
  id            String  @id @default(cuid())
  // A human number for the staff to say out loud to each other. Internal
  // only: it is never sent to the customer, which is the whole point.
  ticketNumber  Int     @unique @default(autoincrement())
  // The customer's WhatsApp number, international, no plus — 972501234567.
  // The only identity the bot knows, so every lookup starts here.
  waId          String
  customerName  String?
  userId        String?
  user          User?   @relation("ComplaintCustomer", fields: [userId], references: [id])
  orderId       String?
  order         Order?  @relation(fields: [orderId], references: [id])
  channel       String  @default("WHATSAPP")

  category      String  @default("OTHER")
  severity      String  @default("MEDIUM")
  status        String  @default("OPEN")
  subject       String

  assignedToId  String?
  assignedTo    User?   @relation("ComplaintAssignee", fields: [assignedToId], references: [id])

  firstMessageAt DateTime @default(now())
  lastMessageAt  DateTime @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages ComplaintMessage[]

  @@index([waId])
  @@index([lastMessageAt])
  @@index([status, severity])
}

model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  role        String // CUSTOMER | BOT | STAFF | SYSTEM
  body        String
  authorId    String?
  author      User?     @relation("ComplaintMessageAuthor", fields: [authorId], references: [id])
  // WhatsApp's own message id. Unique, which is what makes the ingest
  // endpoint idempotent: n8n retries, and a retry must not double the thread.
  waMessageId String?   @unique
  mediaMime   String?
  // Path inside the private complaint-media bucket. Never a URL: WhatsApp's
  // own media links expire in minutes and need a bearer token, so a stored
  // URL is a dead link by the time anyone opens the complaint.
  mediaStoragePath String?
  // JSON array of what was removed from `body` before it was saved, e.g.
  // ["credit_card"]. The removed values themselves are not stored anywhere.
  redactedFields String?
  // Everything is internal today. The flag exists so that if a customer-
  // facing view is ever built, what may be shown is a decision someone makes
  // per message rather than a default that leaks the lot.
  internalOnly Boolean @default(true)
  createdAt   DateTime @default(now())

  @@index([complaintId])
  @@index([createdAt])
}

/// One spin of the 3D mall's daily wheel by a signed-in customer. The server
/// rolls it (lib/game-wheel.ts); one a day per account is the unique key.
/// A coupon prize is a personal Promotion whose code is kept here.
model GameSpin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  prize     String
  code      String?
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}

/// A personal coupon the mall's club gave an account: a loyalty reward, a
/// level gift, or cashback on a paid order. The discount itself is the
/// Promotion with the same code; this row says whose it is and why.
model MemberCoupon {
  code      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // welcome | streak7 | days30 | cashback | level3 | level5 | level7 | level10
  orderId   String?  @unique // the paid order a cashback coupon was earned on
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One request for a page, by a session that lapses within 24 hours. The
/// first-party path log (lib/pageview): no IP, no raw user-agent, no visitor
/// id, query string by allow-list only. Raw rows live 90 days
/// (api/internal/pv-rollup) and are folded into PageViewDaily.
model PageView {
  id        String   @id @default(cuid())
  sid       String
  path      String
  query     String?
  referrer  String?
  isBot     Boolean  @default(false)
  /// The crawler's name when the agent is one we recognise — "Googlebot",
  /// never the agent string, which for a person is promised unstored. See
  /// lib/pageview/crawlers.ts.
  bot       String?
  isRsc     Boolean  @default(false)
  country   String?
  device    String?
  createdAt DateTime @default(now())

  @@index([sid, createdAt])
  @@index([createdAt])
  @@index([path, createdAt])
}

/// PageView folded per shop-day, path and bot flag. Carries no identifier,
/// so it is kept without limit.
model PageViewDaily {
  id        String   @id
  date      DateTime @db.Date
  path      String
  isBot     Boolean  @default(false)
  views     Int      @default(0)
  sessions  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([date, path, isBot])
  @@index([date])
}

/// An action a visit took — add to cart, the drawer, the checkout, a
/// payment's result — from a closed list of types with a closed list of
/// keys each (lib/pageview/events.ts). Same terms as PageView: the visit
/// id that lapses within a day, a path with no query, nothing that names a
/// person. Raw rows live 90 days (api/internal/pv-rollup).
model VisitEvent {
  id        String   @id @default(cuid())
  sid       String
  type      String
  path      String
  meta      Json?
  isBot     Boolean  @default(false)
  /// As on PageView.
  bot       String?
  isRsc     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sid, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

/// Every request a crawler makes to a page, with the agent string it sent.
///
/// Separate from PageView on purpose, and the reason is the three things
/// PageView refuses by design: an RSC fetch, a request that is not asking
/// for HTML, and the raw user-agent. The first two are most of what a
/// crawler spends its budget on, and the third is the only way to tell
/// OAI-SearchBot from GPTBot — two OpenAI agents with completely different
/// meanings for this shop, since one feeds the search that already sends
/// more traffic here than Google organic does.
///
/// `verified` is for a second pass that checks the agent's claim against
/// the IP ranges each vendor publishes. Null until then: the question
/// today is whether they arrive at all, not whether somebody is pretending.
///
/// Pruned at 90 days by the pv-rollup cron, beside PageView.
model CrawlerHit {
  id        String   @id @default(cuid())
  /// Normalised, from lib/pageview/crawlers.ts.
  bot       String
  userAgent String
  path      String
  query     String?
  isRsc     Boolean  @default(false)
  /// What it asked for. An HTML request and an RSC payload are different
  /// visits to the same address and only this tells them apart in hindsight.
  accept    String?
  /// What it got back. A crawler spending its visit on 308s is the shape
  /// 2,044 legacy slugs can make, and only this shows it.
  status    Int?
  ip        String?
  country   String?
  verified  Boolean?
  createdAt DateTime @default(now())

  @@index([bot, createdAt])
  @@index([path])
  @@index([createdAt])
}
