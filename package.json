{
  "name": "prec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "check:brands": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-brand-attribution.ts",
    "check:images": "tsx scripts/check-blocked-image-hosts.ts",
    "fix:brands": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-brand-attribution.ts",
    "check:content": "tsx scripts/check-product-content.ts",
    "check:guards": "tsx scripts/check-import-guards.ts",
    "scan:labels": "tsx scripts/check-energy-labels.ts",
    "check:categories": "tsx scripts/check-category-rules.ts",
    "fix:categories": "NODE_OPTIONS=--conditions=react-server tsx scripts/classify-categories.ts",
    "check:rowkeys": "tsx scripts/check-source-row-key.ts",
    "fix:rowkeys": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-source-row-keys.ts",
    "fix:category-names": "tsx scripts/sync-category-names.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
